{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.4",
        "ext-json": "*",
        "berkayk/onesignal-laravel": "^1.0",
        "beyondcode/laravel-websockets": "^1.12",
        "coinbase/coinbase-commerce": "dev-master#107702e71f8b058701f92a3a101f5954ca6792e1",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "graham-campbell/digitalocean": "^8.3",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.5",
        "kpolicar/nova-oryxbot-theme": "*",
        "kpolicar/oryxbot-help": "*",
        "kpolicar/oryxbot-insights": "*",
        "kpolicar/oryxbot-instance": "*",
        "kpolicar/oryxbot-logs": "*",
        "laravel/cashier": "^12.4",
        "laravel/fortify": "^1.6",
        "laravel/framework": "^8.0",
        "laravel/nova": "*",
        "laravel/passport": "^10.0",
        "laravel/telescope": "^4.10",
        "laravel/tinker": "^2.0",
        "mcamara/laravel-localization": "^1.6",
        "phpseclib/bcmath_compat": "1.0.4",
        "predis/predis": "^1.1",
        "pusher/pusher-php-server": "~3.0",
        "team-reflex/discord-php": "^5.1"
    },
    "require-dev": {
        "facade/ignition": "^2.3.6",
        "fzaninotto/faker": "^1.9.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "DiscordApp\\": "discordapp/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "./nova"
        },
        {
            "type": "path",
            "url": "./nova-components/NovaOryxbotTheme"
        },
        {
            "type": "path",
            "url": "./nova-components/OryxbotInstance"
        },
        {
            "type": "path",
            "url": "./nova-components/OryxbotLogs"
        },
        {
            "type": "path",
            "url": "./nova-components/OryxbotInsights"
        },
        {
            "type": "path",
            "url": "./nova-components/OryxbotHelp"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Fossil01/coinbase-commerce-php"
        }
    ]
}
