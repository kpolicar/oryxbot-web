{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
        "all": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js && npm run build-oryxbot-instance && npm run build-oryxbot-logs && npm run build-oryxbot-insights",
        "watch": "npm run development -- --watch",
        "watch-poll": "npm run watch -- --watch-poll",
        "hot": "cross-env NODE_ENV=development node_modules/webpack-dev-server/bin/webpack-dev-server.js --inline --hot --disable-host-check --config=node_modules/laravel-mix/setup/webpack.config.js",
        "prod": "npm run production",
        "production": "cross-env NODE_ENV=production node_modules/webpack/bin/webpack.js --no-progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
        "build": "npm run production",
        "build-oryxbot-instance": "cd nova-components/OryxbotInstance && npm run dev",
        "build-oryxbot-instance-prod": "cd nova-components/OryxbotInstance && npm run prod",
        "build-oryxbot-logs": "cd nova-components/OryxbotLogs && npm run dev",
        "build-oryxbot-logs-prod": "cd nova-components/OryxbotLogs && npm run prod",
        "build-oryxbot-insights": "cd nova-components/OryxbotInsights && npm run dev",
        "build-oryxbot-insights-prod": "cd nova-components/OryxbotInsights && npm run prod"
    },
    "devDependencies": {
        "@tailwindcss/custom-forms": "^0.2.1",
        "axios": "^0.19",
        "cross-env": "^7.0.3",
        "laravel-mix": "^5.0.9",
        "lodash": "^4.17.21",
        "resolve-url-loader": "^3.1.2",
        "sass": "^1.32.8",
        "sass-loader": "^8.0.2",
        "vue-template-compiler": "^2.6.12"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^5.15.2",
        "@stripe/stripe-js": "^1.13.1",
        "install": "^0.13.0",
        "npm": "^6.14.10",
        "sweetalert2": "^10.15.5",
        "tailwindcss": "^1.9.6"
    }
}
